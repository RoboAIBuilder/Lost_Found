# Copy this file to .env and fill it in.

# Long random string that signs login cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Google sign-in (see README: "Set up Google sign-in")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Only these school Google Workspace domains can sign in (comma-separated).
# Students are often on a separate domain, e.g. students.district.org
ALLOWED_DOMAINS=district.org,students.district.org

# Who gets the office tools (comma-separated school emails). Everyone else is a student.
STAFF_EMAILS=frontoffice@district.org,ms.rivera@district.org

# Claude API key from console.anthropic.com. Without it, search falls back to keyword matching
# and staff type item details by hand.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5

# Local testing only: shows demo "Office staff" / "Student" buttons instead of Google sign-in,
# and allows plain http. Never set this on the live server.
DEV_LOGIN=0
